assert_eq(not True, False)
assert_eq(not False, True)
assert_eq(-1, 0 - 1)
assert_eq(-1.25, 0 - 1.25)
assert_eq(+1, 1)
assert_eq(+1.125, 1.125)
assert_eq(-123456789012345678901234567890, 0 - 123456789012345678901234567890)
assert_eq(+123456789012345678901234567890, 123456789012345678901234567890)
assert_eq(~-1, 0)
assert_eq(~123456789012345678901234567890, -123456789012345678901234567891)
