assert_eq(False < True, True)
assert_eq(True < False, False)
assert_eq(0 < 1, True)
assert_eq(1 < 0, False)
assert_eq(0.1 < 0.2, True)
assert_eq(0.2 < 0.1, False)
assert_eq(1e50 < 100000000000000007629769841091887003294964970946561, True)
assert_eq("" < "a", True)
assert_eq("a" < "", False)
assert_eq(b"" < b"a", True)
assert_eq(b"a" < b"", False)
assert_eq(() < (1,), True)
assert_eq((1,) < (), False)
assert_eq([] < [1], True)
assert_eq([1] < [], False)
assert_fail("a1 = False < 1", error_message = "TypeError: '<' not supported between instances of 'bool' and 'int'")

