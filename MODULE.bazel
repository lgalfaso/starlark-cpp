module(
    name = "starlark",
    version = "0.0.1",
)

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "google_benchmark", version = "1.9.5")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "protobuf-matchers", version = "0.1.2")
bazel_dep(name = "rules_fuzzing", version = "0.8.0")

# Added as the build is too noisy when using @20260526.0 from the dependencies.
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "llvm", version = "0.8.24")
bazel_dep(name = "platforms", version = "1.1.0")

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "23.1.2")
use_repo(llvm, "llvm-project", "llvm_version")

register_toolchains("@llvm//toolchain:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "ucd",
    build_file_content = """
exports_files(
    glob(["**/*"]),
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-ez5VVRQGC5IpDRVPU2VcXrD6YrFusEwDQ0/3LRpmoNg=",
    url = "https://unicode.org/Public/18.0.0/ucd/UCD.zip",
)
