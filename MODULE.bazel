module(
    name = "starlark",
    version = "0.0.1",
)

bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "google_benchmark", version = "1.9.4")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "protobuf", version = "33.1")
bazel_dep(name = "protobuf-matchers", version = "0.1.1")
bazel_dep(name = "rules_fuzzing", version = "0.6.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "ucd",
    build_file_content = """
exports_files(
    glob(["**/*"]),
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-IGbRkJsuqTkWzgktocDuSAjqPvhAfJS08U9bfrJj0o4=",
    url = "https://unicode.org/Public/17.0.0/ucd/UCD.zip",
)
