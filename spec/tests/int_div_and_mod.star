a = [438975234098527439820754320897532498, 378346593746012861978639785632523, 33287463219874623984762349786321947862, -34782369876213958176239587236, -2301849327408973048127304237, -3721874032874012874028740812375402813]

[
  assert_eq((x // y) * y + (x % y), x)
  for x in a for y in a
