inf = float(1 << 1023) * 10
elements = [
  [-inf],
  [-100100000000000007629769841091887003294964970946560],
  [-100000000000000007629769841091887003294964970946561],
  [-1e50, -100000000000000007629769841091887003294964970946560],
  [-100000000000000007629769841091887003294964970946559],
  [-100000000000000006629769841091887003294964970946560],
  [-3, -3.0],
  [-2.5],
  [-2, -2.0],
  [-1.5],
  [-1, -1.0],
  [-0.5],
  [-1e-308],
  [-5e-324],
  [0, 0.0, -0.0],
  [5e-324],
  [1e-308],
  [0.5],
  [1, 1.0],
  [1.5],
  [2, 2.0],
  [2.25],
  [2.5],
  [2.75],
  [3, 3.0],
  [100000000000000006629769841091887003294964970946560],
  [100000000000000007629769841091887003294964970946559],
  [1e50, 100000000000000007629769841091887003294964970946560],
  [100000000000000007629769841091887003294964970946561],
  [100100000000000007629769841091887003294964970946560],
  [inf],
  [inf/inf, -inf/inf],   # NaN, -NaN
]

def cmp_all():
  for a in range(len(elements)):
    for aa in elements[a]:
      for b in range(len(elements)):
        for bb in elements[b]:
          assert_eq(a < b, aa < bb)
          assert_eq(a <= b, aa <= bb)
          assert_eq(a == b, aa == bb)
          assert_eq(a >= b, aa >= bb)
          assert_eq(a > b, aa > bb)

cmp_all()


assert_fail('''1 < True''')
