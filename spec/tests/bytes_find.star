# Named arguments.
assert_fail('''b'abc'.find(sub = b'')''')
assert_fail('''b'abc'.find(b'', start = 0)''')
assert_fail('''b'abc'.find(b'', 0, end = 0)''')
assert_fail('''b'abc'.rfind(sub = b'')''')
assert_fail('''b'abc'.rfind(b'', start = 0)''')
assert_fail('''b'abc'.rfind(b'', 0, end = 0)''')

