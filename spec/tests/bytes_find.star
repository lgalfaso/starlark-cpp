# No arguments.
assert_fail('''b''.find()''')
assert_fail('''b''.rfind()''')


# One argument.
assert_fail('''b''.find(())''')
assert_fail('''b''.rfind(())''')

assert_eq(b'banana'.find(b''), 0)
assert_eq(b'banana'.find(b'an'), 1)
assert_eq(b'banana'.find(b'ban'), 0)
assert_eq(b'banana'.find(b'bb'), -1)
assert_eq(b'banana'.find(97), 1)

assert_eq(b'banana'.rfind(b''), 6)
assert_eq(b'banana'.rfind(b'an'), 3)
assert_eq(b'banana'.rfind(b'ban'), 0)
assert_eq(b'banana'.rfind(b'bb'), -1)
assert_eq(b'banana'.rfind(97), 5)


# Two arguments.
assert_fail('''b'banana'.find(b'', False)''')
assert_fail('''b'banana'.rfind(b'', False)''')

assert_eq(b'abab'.find(b'ab', -5), 0)
assert_eq(b'abab'.find(b'ab', -4), 0)
assert_eq(b'abab'.find(b'ab', -3), 2)
assert_eq(b'abab'.find(b'ab', -2), 2)
assert_eq(b'abab'.find(b'ab', -1), -1)
assert_eq(b'abab'.find(b'ab', 0), 0)
assert_eq(b'abab'.find(b'ab', 1), 2)
assert_eq(b'abab'.find(b'ab', 2), 2)
assert_eq(b'abab'.find(b'ab', 3), -1)
assert_eq(b'abab'.find(b'ab', 4), -1)
assert_eq(b'abab'.find(b'ab', 5), -1)

assert_eq(b'abab'.rfind(b'ab', -5), 2)
assert_eq(b'abab'.rfind(b'ab', -4), 2)
assert_eq(b'abab'.rfind(b'ab', -3), 2)
assert_eq(b'abab'.rfind(b'ab', -2), 2)
assert_eq(b'abab'.rfind(b'ab', -1), -1)
assert_eq(b'abab'.rfind(b'ab', 0), 2)
assert_eq(b'abab'.rfind(b'ab', 1), 2)
assert_eq(b'abab'.rfind(b'ab', 2), 2)
assert_eq(b'abab'.rfind(b'ab', 3), -1)
assert_eq(b'abab'.rfind(b'ab', 4), -1)
assert_eq(b'abab'.rfind(b'ab', 5), -1)


