inf = 1e308 * 10
nan = inf/inf
assert_eq('0.0', str(0.0))
assert_eq('-0.0', str(-0.0))
assert_eq('1.234', str(1.234))
assert_eq('1e-10', str(1e-10))
assert_eq('1e-09', str(1e-9))
assert_eq('1e-08', str(1e-8))
assert_eq('1e-07', str(1e-7))
assert_eq('1e-06', str(1e-6))
assert_eq('1e-05', str(1e-5))
assert_eq('0.0001', str(1e-4))
assert_eq('0.001', str(1e-3))
assert_eq('0.01', str(1e-2))
assert_eq('0.1', str(1e-1))
assert_eq('1.0', str(1.0))
assert_eq('10.0', str(10.0))
assert_eq('100.0', str(100.0))
assert_eq('1000.0', str(1000.0))
assert_eq('10000.0', str(10000.0))
assert_eq('100000.0', str(100000.0))
assert_eq('1000000.0', str(1000000.0))
assert_eq('10000000.0', str(10000000.0))
assert_eq('100000000.0', str(100000000.0))
assert_eq('1000000000.0', str(1000000000.0))
assert_eq('10000000000.0', str(10000000000.0))
assert_eq('100000000000.0', str(100000000000.0))
assert_eq('1000000000000.0', str(1000000000000.0))
assert_eq('10000000000000.0', str(10000000000000.0))
assert_eq('100000000000000.0', str(100000000000000.0))
assert_eq('1000000000000000.0', str(1000000000000000.0))
assert_eq('1e+16', str(10000000000000000.0))
assert_eq('1e+17', str(100000000000000000.0))
assert_eq('1234567890123456.0', str(1234567890123456.0))
assert_eq('1.2345678901234568e+16', str(12345678901234567.0))
assert_eq('1.0000000000000004e+18', str(1000000000000000321.0))
assert_eq('-1.234', str(-1.234))
assert_eq('-1.0', str(-1.0))
assert_eq('-10.0', str(-10.0))
assert_eq('-100.0', str(-100.0))
assert_eq('-1000.0', str(-1000.0))
assert_eq('-10000.0', str(-10000.0))
assert_eq('-100000.0', str(-100000.0))
assert_eq('-1000000.0', str(-1000000.0))
assert_eq('-10000000.0', str(-10000000.0))
assert_eq('-100000000.0', str(-100000000.0))
assert_eq('-1000000000.0', str(-1000000000.0))
assert_eq('-10000000000.0', str(-10000000000.0))
assert_eq('-100000000000.0', str(-100000000000.0))
assert_eq('-1000000000000.0', str(-1000000000000.0))
assert_eq('-10000000000000.0', str(-10000000000000.0))
assert_eq('-100000000000000.0', str(-100000000000000.0))
assert_eq('-1000000000000000.0', str(-1000000000000000.0))
assert_eq('-1e+16', str(-10000000000000000.0))
assert_eq('-1e+17', str(-100000000000000000.0))
assert_eq('-1234567890123456.0', str(-1234567890123456.0))
assert_eq('-1.2345678901234568e+16', str(-12345678901234567.0))
assert_eq('-1.0000000000000004e+18', str(-1000000000000000321.0))
assert_eq('nan', str(nan))
assert_eq('nan', str(-nan))
assert_eq('inf', str(inf))
assert_eq('-inf', str(-inf))



