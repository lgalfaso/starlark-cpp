assert_eq(b'abab'.index(b'ab', -4, 4), 0)
assert_eq(b'abab'.index(b'ab', -4, 5), 0)
assert_fail('''b'abab'.index(b'ab', -3, -5)''')
assert_fail('''b'abab'.index(b'ab', -3, -4)''')
assert_fail('''b'abab'.index(b'ab', -3, -3)''')
