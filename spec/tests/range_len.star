assert_eq(len(range(0, 0, 1)), 0)
assert_eq(len(range(0, 0, -1)), 0)
assert_eq(len(range(0, 99, 1)), 99)
assert_eq(len(range(0, 100, 1)), 100)
assert_eq(len(range(0, 101, 1)), 101)
assert_eq(len(range(0, 99, 10)), 10)
assert_eq(len(range(0, 100, 10)), 10)
assert_eq(len(range(0, 101, 10)), 11)
assert_eq(len(range(0, 100, -1)), 0)
assert_eq(len(range(0, 100, 1000)), 1)
assert_eq(len(range(0, 100, -1000)), 0)
assert_eq(len(range(99, 0, -1)), 99)
assert_eq(len(range(100, 0, -1)), 100)
assert_eq(len(range(100, 0, -1)), 100)
assert_eq(len(range(99, 0, -10)), 10)
assert_eq(len(range(100, 0, 1000)), 0)
assert_eq(len(range(100, 0, -1000)), 1)

half_min_int64 = -0x4000000000000000
half_max_int64 =  0x3fffffffffffffff
assert_eq(len(range(half_min_int64, half_max_int64, -2)), 0)
assert_eq(len(range(half_min_int64, half_max_int64, -1)), 0)
assert_eq(len(range(half_min_int64, half_max_int64, 1)), (1 << 63) - 1)
assert_eq(len(range(half_min_int64, half_max_int64, 2)), (1 << 62))
assert_eq(len(range(half_max_int64, half_min_int64, -2)), (1 << 62))
assert_eq(len(range(half_max_int64, half_min_int64, -1)), (1 << 63) - 1)
assert_eq(len(range(half_max_int64, half_min_int64, 1)), 0)
assert_eq(len(range(half_max_int64, half_min_int64, 2)), 0)

