assert_true([''.elems()] <= [''.elems()])
assert_fail('''"".elems() <= ''.elems()''')
assert_true([b''.elems()] <= [b''.elems()])
assert_fail('''b''.elems() <= b''.elems()''')
assert_true([len] <= [len])
assert_fail('''len <= len''')
assert_true([range(10)] <= [range(10)])
assert_fail('''range(10) <= range(10)''')
assert_true([set()] <= [set()])
assert_fail('''set() <= set()''')
